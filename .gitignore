# LaTeX build artifacts (compiled cv.pdf per application IS tracked; these intermediates are not)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*.nav
*.snm
*.vrb

# Local tooling state, not project content
.atl/
.claude/

# Python (uv-managed environment)
.venv/
.pytest_cache/
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db

# Source CVs kept locally for reference, never part of the generated/tracked output
/*.pdf
